div(class=`Wrapper ${styles.wrapper}`)
  //- NERV System Header
  .nerv-header-panel(class=styles.nerv_header)
    span.header-id(class=styles.header_id) NERV-001
    span.header-title(class=styles.header_title) パイロットファイル
    span.header-status(class=styles.header_status) ● ONLINE

  h1(class=`Title ${styles.title}`) 
    span(class=styles.title_jp) デニス・ファディリ
    span(class=styles.title_en) DENIS_FADHILI.exe

  //- Warning box for main description
  div(class=`EvaBox ${styles.eva_box}`)
    span(class=styles.box_label) ⚠ PILOT DATA
    p(class=`Description ${styles.description}`)
      | Spatial Data Science student building scalable applications that solve real-world problems. Proficient in modern web stacks (Next.js, Node.js, Python) and cloud platforms, with experience in full-stack development, AI/ML integration, and geospatial systems.

  //- Stats Panel
  div(class=styles.stats_panel)
    div(class=styles.stat_item)
      span(class=styles.stat_label) SYNC_RATE
      span(class=styles.stat_value) 400%
    div(class=styles.stat_item)
      span(class=styles.stat_label) PROJECTS
      span(class=styles.stat_value) 5+
    div(class=styles.stat_item)
      span(class=styles.stat_label) STATUS
      span(class=styles.stat_value) ACTIVE

  //- Education Section
  div(class=`EvaBox ${styles.eva_box}`)
    span(class=styles.box_label) ⚠ EDUCATION
    p(class=`Description ${styles.description}`)
      | BSc Hons, Spatial Data Science and Smart Cities — The Hong Kong Polytechnic University (Expected 2029)
    p(class=`Description ${styles.description}`)
      | Certificate in Data Analytics and Visualization — Strathmore University (2025)

  //- Experience Section
  div(class=`CautionBox ${styles.caution_box}`)
    span(class=styles.caution_label) MISSION LOG
    p(class=`Description ${styles.description}`)
      strong Data Analyst @ BrickLabs AI
      |  (Sep-Dec 2024) — Drove user growth from 4,000 to 11,000 through EDA insights. Automated workflows improving efficiency by 30%.
    p(class=`Description ${styles.description}`)
      strong Extern @ National Geographic Society & TNC
      |  (Feb 2025-Present) — Led geospatial analysis on 4,100 km² of Lake Victoria using OBIA on Sentinel-2 imagery.

  //- Skills Section
  div(class=styles.stats_panel)
    div(class=styles.stat_item)
      span(class=styles.stat_label) LANGUAGES
      span(class=styles.stat_value_small) Python, JS, SQL
    div(class=styles.stat_item)
      span(class=styles.stat_label) FRAMEWORKS
      span(class=styles.stat_value_small) Next.js, Node
    div(class=styles.stat_item)
      span(class=styles.stat_label) GIS
      span(class=styles.stat_value_small) ArcGIS, QGIS

  //- Download CV Button
  div(class=styles.cv_section)
    a(class=styles.cv_button href="/Tech_resume.pdf" download target="_blank")
      span(class=styles.cv_icon) ▼
      span(class=styles.cv_text) DOWNLOAD_CV.pdf
      span(class=styles.cv_jp) 履歴書をダウンロード

  div(class=`Social ${styles.social}`)
    span(class=styles.social__title) 
      | 通信リンク
      span(class=styles.social__subtitle) // COMM LINKS

    ul(class=styles.social__list)
      each social, index in socials
        li(class=styles.social__item)
          a(class=styles.social__link href=social.url target="_blank")
            span(class=styles.link_bracket) [
            span=social.label
            span(class=styles.link_bracket) ]
